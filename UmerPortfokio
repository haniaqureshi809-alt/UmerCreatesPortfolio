<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Umer Creates · From RuneScape to AI Reels</title>
<meta name="description" content="Umer Creates: RuneScape creator, then game developer, now an Instagram Reel creator using AI. Based in Pakistan.">
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,800&family=DM+Sans:wght@400;500;700&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#eeede9; --card:#fff; --ink:#15151c; --muted:#5d5d6b; --line:#d7d5cf; --acc:#ff4b2b; --acc2:#2b5bff; --dark:#15151c; --darktext:#f4f3ef;
  color-scheme:light; box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px); padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#101015;--card:#1a1a22;--ink:#f4f3ef;--muted:#a1a0ae;--line:#2d2d38;--dark:#f4f3ef;--darktext:#15151c;color-scheme:dark}}
:root[data-theme="dark"]{--bg:#101015;--card:#1a1a22;--ink:#f4f3ef;--muted:#a1a0ae;--line:#2d2d38;--dark:#f4f3ef;--darktext:#15151c;color-scheme:dark}
*,*::before,*::after{box-sizing:inherit}
html{scroll-behavior:smooth;scroll-padding-top:80px}
body{margin:0;background:var(--bg);color:var(--ink);font:400 17px/1.6 "DM Sans",system-ui,sans-serif;overflow-x:hidden}
h1,h2,h3{font-family:"Bricolage Grotesque","Arial Black",sans-serif;font-weight:800;line-height:1;margin:0;letter-spacing:-.03em}
a{color:inherit}
a:focus-visible,button:focus-visible{outline:3px solid var(--acc2);outline-offset:3px}
.wrap{max-width:1080px;margin:0 auto;padding:0 22px}
.pill{display:inline-flex;align-items:center;gap:8px;padding:13px 22px;border-radius:999px;border:2px solid var(--ink);font-weight:700;text-decoration:none;background:transparent}
.pill.solid{background:var(--ink);color:var(--bg)}
.pill.hot{background:var(--acc);border-color:var(--acc);color:#fff}

/* nav */
nav{position:sticky;top:0;z-index:20;background:color-mix(in srgb,var(--bg) 88%,transparent);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
nav .wrap{display:flex;align-items:center;justify-content:space-between;height:60px}
nav b{font:800 1.15rem "Bricolage Grotesque",sans-serif;text-decoration:none}
nav ul{display:flex;gap:20px;list-style:none;margin:0;padding:0;font-size:.95rem;font-weight:500}
nav ul a{text-decoration:none;color:var(--muted)}
nav ul a:hover{color:var(--ink)}

/* hero */
.hero{display:grid;grid-template-columns:1.25fr .75fr;gap:40px;align-items:center;padding:56px 0 48px}
.live{display:inline-flex;gap:10px;align-items:center;font-size:.92rem;font-weight:700;margin-bottom:20px}
.live::before{content:"";width:10px;height:10px;border-radius:50%;background:var(--acc);animation:blink 1.4s infinite}
@keyframes blink{50%{opacity:.25}}
h1{font-size:clamp(2.7rem,8.4vw,6rem)}
h1 em{font-style:normal;color:var(--acc)}
.hero p.sub{font-size:1.2rem;color:var(--muted);max-width:32em;margin:22px 0 26px}
.links{display:flex;flex-wrap:wrap;gap:10px}
.me{aspect-ratio:4/5;border-radius:28px;background:linear-gradient(150deg,var(--acc),#ff9a3c 55%,var(--acc2));position:relative;overflow:hidden;display:grid;place-items:center;transform:rotate(2deg)}
.me span{font:800 9rem "Bricolage Grotesque",sans-serif;color:#fff;opacity:.92}
.me small{position:absolute;left:16px;bottom:14px;color:#fff;font-weight:700;background:#0000004d;padding:5px 12px;border-radius:999px}

/* stat tiles */
.tiles{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:40px}
.tile{background:var(--card);border-radius:20px;padding:20px;border:1px solid var(--line)}
.tile b{display:block;font:800 1.9rem "Bricolage Grotesque",sans-serif;letter-spacing:-.03em}
.tile span{color:var(--muted);font-size:.92rem}

/* marquee */
.marq{background:var(--dark);color:var(--darktext);overflow:hidden;white-space:nowrap;padding:16px 0;font:800 1.1rem "Bricolage Grotesque",sans-serif}
.marq div{display:inline-block;animation:slide 28s linear infinite}
@keyframes slide{to{transform:translateX(-50%)}}

/* live counters */
.livebox{background:var(--dark);color:var(--darktext);border-radius:36px;padding:44px 32px;margin-top:40px}
.livebox .live{margin-bottom:8px}
.livebox h2{font-size:clamp(1.8rem,4.4vw,2.8rem);max-width:none;margin-bottom:28px}
.cnt{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.c{border:1px solid color-mix(in srgb,var(--darktext) 25%,transparent);border-radius:22px;padding:22px}
.c.main{background:var(--acc);border-color:var(--acc);color:#fff}
.c b{display:block;font:800 clamp(2rem,5vw,3.2rem)/1 "Bricolage Grotesque",sans-serif;letter-spacing:-.04em;font-variant-numeric:tabular-nums}
.c span{display:block;margin-top:8px;font-size:.92rem;opacity:.85}
.livebox small{display:block;margin-top:18px;opacity:.7}
@media(max-width:820px){.cnt{grid-template-columns:1fr 1fr}}

/* sections */
section{padding:84px 0}
.kick{font-weight:700;color:var(--acc);margin-bottom:12px}
h2{font-size:clamp(2.1rem,5.6vw,3.8rem);max-width:12em}
.lead{color:var(--muted);font-size:1.12rem;max-width:32em;margin:16px 0 36px}

/* skills */
.skills{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}
.sk{background:var(--card);border:1px solid var(--line);border-radius:26px;padding:28px}
.sk i{font:normal 800 .95rem "DM Sans";color:var(--acc)}
.sk h3{font-size:1.7rem;margin:10px 0}
.sk p{margin:0;color:var(--muted)}

/* story */
.story{display:grid;grid-template-columns:.8fr 1.2fr;gap:48px}
.sticky{position:sticky;top:100px;align-self:start}
.chap{font-weight:700;color:var(--muted)}
.big{font:800 clamp(4rem,12vw,8rem)/1 "Bricolage Grotesque",sans-serif;letter-spacing:-.05em;color:var(--acc);margin-top:6px}
.bar{height:6px;border-radius:6px;background:var(--line);margin-top:22px;max-width:260px}
.bar i{display:block;height:100%;width:33%;background:var(--acc);border-radius:6px;transition:width .3s}
.ch{background:var(--card);border:1px solid var(--line);border-radius:28px;padding:32px;margin-bottom:22px;min-height:260px}
.ch .t{font-weight:700;color:var(--acc2)}
.ch h3{font-size:2rem;margin:10px 0 12px}
.ch p{margin:0;color:var(--muted);max-width:30em}

/* work */
.work{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
.w{border-radius:26px;padding:26px;min-height:300px;display:flex;flex-direction:column;justify-content:flex-end;color:#fff}
.w h3{font-size:1.6rem;margin-bottom:8px}
.w p{margin:0 0 14px;opacity:.92;font-size:.98rem}
.w a{font-weight:700}
.w1{background:linear-gradient(160deg,#ff4b2b,#a3123a)}
.w2{background:linear-gradient(160deg,#2b5bff,#1b2f8f)}
.w3{background:linear-gradient(160deg,#15151c,#3b3b52)}

/* follow */
.follow{background:var(--dark);color:var(--darktext);border-radius:36px;padding:64px 32px;text-align:center;margin-bottom:56px}
.follow h2{margin:0 auto 14px;max-width:11em}
.follow p{opacity:.8;max-width:30em;margin:0 auto 28px}
.follow .links{justify-content:center}
.follow .pill{border-color:var(--darktext);color:var(--darktext)}
.follow .pill.hot{border-color:var(--acc);color:#fff}
footer{padding:0 0 48px;color:var(--muted);font-size:.92rem;text-align:center}

@media(max-width:820px){
  nav ul{gap:12px;font-size:.85rem}
  nav ul li:nth-child(n+4){display:none}
  .hero,.story{grid-template-columns:1fr}
  .me{max-width:280px;order:-1}
  .me span{font-size:6rem}
  .tiles{grid-template-columns:repeat(2,1fr)}
  .skills,.work{grid-template-columns:1fr}
  .sticky{position:static}
  section{padding:60px 0}
}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important;scroll-behavior:auto!important}}
</style>
