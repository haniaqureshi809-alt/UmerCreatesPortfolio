<script>
(function(){
  // Update these from your analytics. Total followers adds up Instagram and YouTube.
  var STATS={ig:27,yt:null,views:1540,updated:'8 Nov 2026'};
  STATS.followers=(STATS.ig==null&&STATS.yt==null)?null:(STATS.ig||0)+(STATS.yt||0);
  var els=[].slice.call(document.querySelectorAll('[data-k]'));
  var fmt=new Intl.NumberFormat('en-US');
  var reduce=window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  function run(el){
    var v=STATS[el.dataset.k];
    if(v==null){return;}
    if(reduce){el.textContent=fmt.format(v);return;}
    var t0=null,d=1800;
    function step(t){
      if(!t0)t0=t;
      var p=Math.min(1,(t-t0)/d),e=1-Math.pow(1-p,3);
      el.textContent=fmt.format(Math.round(v*e));
      if(p<1)requestAnimationFrame(step);
    }
    requestAnimationFrame(step);
  }
  if(STATS.updated)document.getElementById('upd').textContent='Last updated '+STATS.updated+'.';
  if('IntersectionObserver' in window){
    var io=new IntersectionObserver(function(es){
      es.forEach(function(x){if(x.isIntersecting){els.forEach(run);io.disconnect();}});
    },{threshold:.3});
    io.observe(document.getElementById('livebox'));
  }else{els.forEach(run);}
})();
(function(){
  var cards=[].slice.call(document.querySelectorAll('.ch'));
  var chap=document.getElementById('chap'),big=document.getElementById('big'),pb=document.getElementById('pb');
  function upd(){
    var mid=window.innerHeight*0.5,cur=cards[0];
    cards.forEach(function(c){if(c.getBoundingClientRect().top<mid)cur=c;});
    chap.textContent='CHAPTER '+cur.dataset.n+' / 3';
    big.textContent=cur.dataset.big;
    pb.style.width=(cur.dataset.n/3*100)+'%';
  }
  window.addEventListener('scroll',upd,{passive:true});
  window.addEventListener('resize',upd);
  upd();
})();
</script>
